{
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
        "lint": "eslint js --max-warnings 0",
        "lint:fix": "eslint js --fix",
        "format": "prettier --write \"js/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"css/**/*.css\" \"*.{ts,mts,mjs}\"",
        "format:check": "prettier --check \"js/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"css/**/*.css\" \"*.{ts,mts,mjs}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
        "test:e2e": "playwright test",
        "test:e2e:update": "playwright test --update-snapshots"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.99.1",
        "axios": "^1.15.0",
        "lucide-react": "^0.511.0",
        "phoenix": "^1.8.4",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router-dom": "^7.5.1",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.4.1",
        "@types/phoenix": "^1.6.7",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "axios-mock-adapter": "^2.1.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.69.0",
        "vitest": "^4.1.11"
    }
}
