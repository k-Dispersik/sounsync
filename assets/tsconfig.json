{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./js/*"]
        },
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": []
    },
    "include": ["js/**/*"]
}
